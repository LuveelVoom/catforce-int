#C max-gen 24
#C num-catalyst 2
#C stable-interval 10
#C output layout_example_results.rle
#C output-list layout_example_list.txt
#C cat 2o$2o 100 0 0 .
#C cat bo$obo$bo 100 -1 -1 .
#C cat 2o$obo$b2o 100 -1 -1 |
#C cat bo$obo$obo$bo 100 -1 -2 /
#C cat b2o$o2bo$bobo$2bo 100 -2 -2 +
#C cat 2o$obo$bobo$2bo! 100 -1 -1 +
