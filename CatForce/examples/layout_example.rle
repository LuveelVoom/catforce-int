#C Green (state 1) = active pattern, blue (state 2) = where catalysts may go.
#C Other states: 3 bait, 4 goal, 5 fixed catalyst, 6 keep empty; see README "Layout files".
#CXRLE Pos=-10,-10
x = 16, y = 21, rule = B3/S23History
